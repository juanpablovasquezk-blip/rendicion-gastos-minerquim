# Copia este archivo como .env.local y completa los valores.
# En Supabase: Project Settings → API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. NUNCA con prefijo NEXT_PUBLIC_ ni se sube a GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la aplicación (para enlaces en WhatsApp y notificaciones)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Inteligencia Artificial / OCR (Google Gemini Flash)
GEMINI_API_KEY=

# Notificaciones WhatsApp (UltraMsg API)
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

# Web Push (VAPID Keys para notificaciones push en navegador/móvil)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@minerquim.cl
